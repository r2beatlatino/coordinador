# Copiar a `.env` (al lado del docker-compose.yml) y completar. ⛔ El `.env` NO va al repo.
# Acá no va ningún secreto: sólo DÓNDE corre cada cosa. Es lo que cambia al mudar de máquina.

# El nombre del conjunto: prefijo de los contenedores y de los volúmenes.
COMPOSE_PROJECT_NAME=enenos

# La hora de los contenedores (misiones del día, respaldo de las 4, fechas del log).
# ⛔ Tiene que ser LA MISMA que usa hoy la máquina de prod (`timedatectl` allá), o el «día» cambia de hora.
TZ=America/Lima

# ── R2Beat 2013 ──────────────────────────────────────────────────────────────────────────────
# La IP pública por la que los jugadores llegan a ESTA máquina (va dentro del paquete de canales).
# En esta PC, para probar: 127.0.0.1
R2_IP_PUBLICA=
# El NOMBRE público del juego (el que usa el launcher). Con él puesto, el server saca su IP del DNS y la anuncia en
# los canales: R2_IP_PUBLICA pasa a ser la red de seguridad (lo que se anuncia mientras el DNS no contesta bien).
# Vacío = no se usa. En esta PC, para probar: localhost, y R2_NOMBRE_PUBLICO_PRIVADAS=1.
R2_NOMBRE_PUBLICO=
R2_NOMBRE_PUBLICO_PRIVADAS=
# En qué IP de la máquina se abren el login y los canales (0.0.0.0 = todas).
JUEGO_PUBLICAR=0.0.0.0
# La API (web, panel, launcher): sólo para el proxy de la misma máquina.
JUEGO_API_PUBLICAR=127.0.0.1:48190
# A quién le cree la API la IP del jugador: el proxy. Con el proxy en la MISMA máquina y el puerto
# publicado en 127.0.0.1, el pedido llega desde la puerta de la red de Docker (172.16.0.0/12).
JUEGO_PROXIES=127.0.0.1,::1,172.16.0.0/12
# Vacío en prod. En local: 1 (abre los comandos de desarrollo).
R2_CONSOLA_GM=
# Modo de ingreso: vacío = usuario + hash como siempre; `pase` = sólo pases Ed25519 de Cuenta Eñeños.
R2_LOGIN=
# Clave pública Ed25519 de Cuenta Eñeños (base64url de 32 bytes, hex de 64 o JWKS JSON) y URL interna de respaldo/panel.
R2_CUENTAS_CLAVE_PUBLICA=
R2_CUENTAS_URL=
R2_CUENTAS_FICHA_INTERNA=

# ── El server de PRUEBA de R2Beat (rama develop del repo público) y la puerta del 48004 (§34) ──
# Se prende sumando `prueba` a COMPOSE_PROFILES (ej. `eda,prueba`) Y moviendo el login de prod adentro:
#   JUEGO_LOGIN_PUERTO=47004  JUEGO_LOGIN_PUBLICAR=127.0.0.1:47004  JUEGO_NOMBRE_PUBLICO_PUERTO=48004
# Vacías = un solo server, como siempre.
JUEGO_LOGIN_PUERTO=
JUEGO_LOGIN_PUBLICAR=
JUEGO_NOMBRE_PUBLICO_PUERTO=
# La imagen del de prueba la arma `actualizar_prueba.sh` (cron cada 5 min) del repo público; no se publica.
PRUEBA_IMAGEN=r2b2013-server:prueba
# Carpeta de la máquina con las tablas y notas del juego (shop_lt.txt, notes_map_2013.json, notes/, tablas-cliente/
# con music_lt.txt adentro, y R2Beat.exe.pristino).
PRUEBA_JUEGO_DIR=
PUERTA_IMAGEN=enenos-puerta:local
# La lista del cliente del server de prueba en el servidor de parches (vacía = la de prod) y el aviso de su tira.
PARCHES_RELEASE_PRUEBA=
PRUEBA_AVISO_TIRA=

# ── Cuenta Eñeños ────────────────────────────────────────────────────────────────────────────
CUENTAS_PUBLICAR=127.0.0.1:48195
CUENTAS_PROXIES=127.0.0.1,::1,172.16.0.0/12
# Con `1`, Cuenta Eñeños es dueña de `cuentas.db` y no abre `datos.db`. Vacío = etapa 0.
R2_CUENTAS_DUENA=
# De dónde lee el estado de cada juego para los amigos (servidor/social.py). Vacío = sin presencia.
R2_PRESENCIA=
# La dirección pública de Cuenta Eñeños (vacía = la de por omisión de servidor/lanzamientos.py).
R2_CUENTAS_URL_PUBLICA=
# ⛔ SECRETO: el webhook del canal de eventos de Discord (invitaciones anticipadas). Sólo en el .env del VPS.
R2_DISCORD_EVENTOS_WEBHOOK=
# Antitrampa centralizado: en qué falta banea por juego (vacío = 3; 0 = nunca banea).
R2_ANTITRAMPA_BANEO_EN=

# ── Servidor de parches ──────────────────────────────────────────────────────────────────────
# ── EDA (otro juego, otro repo). Sólo arranca si acá dice `eda`. ──
COMPOSE_PROFILES=
EDA_IMAGEN=eda-server:local
# La IP pública (vacía = la de R2_IP_PUBLICA), y el relay UDP: de BASE a BASE + MAX_CONEXIONES (FIN tiene que coincidir).
EDA_RELAY_IP=
EDA_RELAY_BASE=26000
EDA_MAX_CONEXIONES=200
EDA_RELAY_FIN=26200
# `pase` = entra sólo con el pase de Cuenta Eñeños; `abierto` = cualquiera (cuentas de prueba).
EDA_LOGIN=pase
# EDA toma la clave pública de Cuenta Eñeños de R2_CUENTAS_CLAVE_PUBLICA (la misma que R2Beat). De respaldo, un
# JWKS por https: https://<el sitio>/cuentas/clave-publica
EDA_PORTERO_CLAVES=
# La cuenta de EDA se llama <prefijo><Eñeños ID> (vacío = en_)
EDA_PREFIJO_CUENTA=
# Cómo nace quien entra a EDA por primera vez: vacío = `vacia` (sin personajes: los crea él) · `personaje` = uno ya hecho
EDA_CUENTA_NUEVA=
# Carpeta de la máquina con el `manifiesto.jws` de EDA (vacío = un volumen).
EDA_WEB_ORIGEN=
# Modo de ingreso en `/auth`: vacío = usuario + hash; `pase` = pase firmado (`aud=parches`).
PARCHES_LOGIN=
PARCHES_CUENTAS_CLAVE_PUBLICA=
# Nombre de la carpeta de la release activa dentro de `/releases` (ej. r2beat2013_2026-11-07).
PARCHES_RELEASE_ACTIVA=
# Volumen con nombre (`parches_releases`) o ruta absoluta de la máquina donde viven las releases.
PARCHES_RELEASES_ORIGEN=parches_releases
# Si se define, `manifest.json` apunta las descargas a esa URL base (CDN); vacío = `/files/<release>/`.
PARCHES_URL_ARCHIVOS=
# Auto-actualización del propio launcher (`GET /launcher/meta` y `GET /launcher/bin`).
PARCHES_LAUNCHER_VERSION=0
PARCHES_LAUNCHER_BIN=
PARCHES_LAUNCHER_URL=
# Lo que se le anuncia al launcher (lo guarda en su net.json): la dirección de parches y un JSON {"host": "ip"}.
PARCHES_LAUNCHER_BASE=
PARCHES_LAUNCHER_IPS=
# Límites y cuotas del servidor de parches.
PARCHES_TOKEN_TTL_SEG=3600
PARCHES_CUOTA_TOKEN_MB=1500
PARCHES_CUOTA_IP_MB_HORA=3000
PARCHES_AUTH_IP_HORA=30
PARCHES_BAN_MINUTOS=30
# Clave del panel viejo (`/status`, `/accounts`). Vacío = panel deshabilitado (503).
# También puede darse como ruta a un archivo montado con PARCHES_CLAVE_PANEL_ARCHIVO.
PARCHES_CLAVE_PANEL=
PARCHES_CLAVE_PANEL_ARCHIVO=

# ── Web y proxy (Caddy) ──────────────────────────────────────────────────────────────────────
# Nombre público del sitio para que Caddy saque HTTPS solo, o `:80` para probar en local por HTTP liso.
WEB_NOMBRE=:80
# En qué IP de la máquina se abren los puertos 80 y 443 (`0.0.0.0` = todas).
WEB_PUBLICAR=0.0.0.0
# A dónde reenvía Caddy cada ruta dentro de la red de contenedores.
WEB_JUEGO_DESTINO=r2beat2013:48190
WEB_CUENTAS_DESTINO=cuentas:48195
WEB_PARCHES_DESTINO=parches:8080

# ── Las imágenes (para traerlas de un registro o de un `docker load` en vez de construirlas) ─
# JUEGO_IMAGEN y WEB_IMAGEN NO se construyen en este repo: salen del repo del R2Beat 2013 (ver docker-compose.yml).
JUEGO_IMAGEN=r2beat2013-juego:local
CUENTAS_IMAGEN=enenos-cuentas:local
PARCHES_IMAGEN=r2beat2013-parches:local
WEB_IMAGEN=r2beat2013-web:local

# ★ 16-nov: entrar / registrarse / vincular el Eñeños ID con Google y Discord (servidor/vinculos.py).
#   Sin ID y secreto, ese proveedor queda APAGADO (el launcher deja su botón en «pronto»).
#   En Google Cloud (credenciales OAuth «Aplicación web») y en el Developer Portal de Discord (OAuth2), la dirección de
#   VUELTA a registrar es <R2_OAUTH_BASE>/oauth/vuelta.   ⛔ Los secretos sólo acá, en el .env del VPS.
R2_OAUTH_BASE=
R2_OAUTH_GOOGLE_ID=
R2_OAUTH_GOOGLE_SECRETO=
R2_OAUTH_DISCORD_ID=
R2_OAUTH_DISCORD_SECRETO=

# ★ 19-nov: el PANEL del Coordinador (servidor/coordinador.py · documentacion/PANEL_COORDINADOR.md).
#   R2_PANEL_URL      la LISTA BLANCA de a dónde vuelve el ingreso con Discord/Google: el origen del panel (https://…,
#                     sin barra final; varios con coma). Vacía = el panel no deja entrar a nadie.
#   R2_PANEL_SALUD    «pase=url;pase=url»: el /salud de cada servidor por la red de adentro (ej. gunbound=http://gunbound:8371/salud).
#                     Sin esto, las tarjetas no muestran estado ni «jugando ahora» (salvo los juegos de R2_PRESENCIA).
#   WEB_COORDINADOR_NOMBRE  el nombre del sitio del panel en Caddy (el mismo de R2_PANEL_URL, sin https://).
R2_PANEL_URL=
R2_PANEL_SALUD=
# IPs y «Comparten su IP» del panel: sólo ADMIN cuyos Eñeños-ID estén aquí (con coma).
# Vacía = nadie. Cambiar el .env requiere recrear el contenedor cuentas.
R2_VEN_IPS=
WEB_COORDINADOR_NOMBRE=
