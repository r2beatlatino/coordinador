# ─────────────────────────────────────────────────────────────────────────────────────────────
#  Caddyfile — la web estática (Astro) y el proxy hacia las tres piezas de atrás.
#  La guía: documentacion/TOPOLOGIA_CONTENEDORES.md
#
#  · WEB_NOMBRE define el sitio:
#      - un nombre de dominio (que apunte directo a esta máquina, sin la nube) -> Caddy saca y
#        renueva solo el certificado HTTPS y lo guarda en el volumen `/data`.
#      - `:80` (por omisión) -> sirve por HTTP liso en el puerto 80, sin pedir certificados
#        (para probar en local).
#  · Ninguna IP ni nombre clavados acá: todo llega por variables de entorno.
# ─────────────────────────────────────────────────────────────────────────────────────────────

{$WEB_NOMBRE::80} {
	encode zstd gzip

	# La API del servidor del juego (web pública, panel /admin y launcher).
	# Conserva el prefijo `/api/*` porque `servidor/api_web.py` espera las rutas así.
	# ★ 16-nov: lo INTERNO del juego (la presencia para los amigos: la pide Cuenta Eñeños por la red de adentro)
	#   no sale a internet, aunque igual pida la ficha.
	@juego_interno path /api/interno /api/interno/*
	handle @juego_interno {
		respond 404
	}
	handle /api/* {
		reverse_proxy {$WEB_JUEGO_DESTINO:r2beat2013:48190}
	}

	# Cuenta Eñeños (hoy: el portero). `servidor/portero.py` acepta las rutas con o sin `/cuentas`.
	# ⛔ 15-nov: los pedidos INTERNOS de Cuenta Eñeños (el panel del juego le pregunta y le avisa cosas de las
	#   cuentas, con su ficha) van por la red de adentro (`http://cuentas:48195`), nunca por acá: a internet, 404.
	@cuentas_interno path /cuentas/interno /cuentas/interno/* /interno /interno/*
	handle @cuentas_interno {
		respond 404
	}
	# ★ 19-nov: el panel del Coordinador vive SÓLO en su nombre (el bloque de abajo), no colgado de este dominio.
	@coordinador_fuera path /cuentas/coordinador /cuentas/coordinador/*
	handle @coordinador_fuera {
		respond 404
	}
	@cuentas path /cuentas /cuentas/*
	handle @cuentas {
		reverse_proxy {$WEB_CUENTAS_DESTINO:cuentas:48195}
	}

	# El servidor de parches bajo `/parches/*`.
	# `handle_path` le quita el prefijo `/parches` antes de pasarlo al contenedor: `/parches/auth`
	# llega como `/auth`, `/parches/manifest` como `/manifest`, `/parches/files/...` como `/files/...`.
	# Así convive en el mismo dominio sin chocar con `/admin` de la web nueva ni pedir otro DNS.
	# ── EDA (otro juego): la lista FIRMADA de su cliente, sin caché, y el canje del pase por su ticket.
	#    Si EDA no está prendido en esta máquina, el canje da 502 y el manifiesto 404: no molesta a nadie.
	handle /eda/manifiesto.jws {
		header Cache-Control "no-store"
		root * /eda-web
		rewrite * /manifiesto.jws
		file_server
	}
	handle /eda/* {
		reverse_proxy {$WEB_EDA_DESTINO:eda:25901}
	}
	# ★ 18-nov: GUNBOUND (otro juego, repo propio gunbound-servidor). Dos servers: prod y PRUEBA.
	#   · /gunbound/lista.jws       la lista FIRMADA de su cliente (clave de publicación de la plataforma), sin caché
	#   · /files-gunbound/  ⛔ cerrada el 23-nov: los archivos del cliente salen SÓLO por la CDN (cdn.eñeños.link/gunbound/)
	#   · /gunbound/*  /gunbound-prueba/*   el canje del pase y la pantalla de personajes (el server acepta el prefijo)
	#   Todo sale de GUNBOUND_WEB_ORIGEN (-> /gunbound-web, sólo lectura). Si GunBound no está prendido: 502 / 404.
	handle /gunbound/lista.jws {
		header Cache-Control "no-store"
		root * /gunbound-web
		rewrite * /lista.jws
		file_server
	}
	# ★ 23-nov (Eñeños: «que el VPS no sirva archivos a nadie más que a Cloudflare»): /files-gunbound/ servía el
	#   cliente entero (1,4 GB) DIRECTO, sin Cloudflare ni pase. La lista firmada manda a la CDN
	#   (cdn.eñeños.link/gunbound/<versión>, que sólo contesta a Cloudflare): esta ruta ya no la usaba nadie.
	handle /files-gunbound/* {
		respond 404
	}
	handle /gunbound-prueba/* {
		reverse_proxy {$WEB_GUNBOUND_PRUEBA_DESTINO:gunbound-prueba:9371}
	}
	handle /gunbound/* {
		reverse_proxy {$WEB_GUNBOUND_DESTINO:gunbound:8371}
	}
	redir /parches /parches/
	handle_path /parches/* {
		reverse_proxy {$WEB_PARCHES_DESTINO:parches:8080}
	}

	# Descarga directa de archivos de la release (`/files/<release>/<archivo>`), por si el manifest
	# usa la base por omisión (`/files/...`) en la raíz del mismo sitio.
	handle /files/* {
		reverse_proxy {$WEB_PARCHES_DESTINO:parches:8080}
	}

	# ★ 17-nov: la ZONA WEB del launcher (la ruleta y los eventos, a la derecha del personaje). Es una carpeta de la
	#   máquina (ZONA_ORIGEN -> /zona, sólo lectura): se cambia copiando archivos, sin rearmar la imagen ni sacar
	#   launcher. «no-cache» = el launcher pregunta cada vez si cambió (si no cambió, no la vuelve a bajar).
	#   La fuente: taller/launcher_zona/ (rama del launcher) · cómo se sube: su LEEME.md
	redir /zona /zona/
	handle_path /zona/* {
		header Cache-Control "no-cache"
		header X-Content-Type-Options "nosniff"
		root * /zona
		try_files {path} {path}/index.html
		file_server
	}

	# El sitio estático compilado desde `web/` (`npm run build` -> `dist/`).
	handle {
		root * /srv
		try_files {path} {path}/index.html {path}.html
		file_server
	}
}

# ─────────────────────────────────────────────────────────────────────────────────────────────
#  ★ 16-nov: auth.eñeños.link — Cuenta Eñeños para Google y Discord (la VUELTA registrada en Google/Discord:
#    /oauth/vuelta) y las dos páginas que Google pide para verificar la marca (inicio y /privacidad, en /auth).
#    Es un nombre aparte a propósito: al mudar de servidor sólo se apunta el DNS, y Google no cambia nada.
#    Sin WEB_AUTH_NOMBRE queda en `http://auth.localhost` (local: sin certificados ni pedidos a internet).
# ─────────────────────────────────────────────────────────────────────────────────────────────
{$WEB_AUTH_NOMBRE:http://auth.localhost} {
	encode zstd gzip
	@interno path /interno /interno/* /cuentas/interno /cuentas/interno/* /cuentas/coordinador /cuentas/coordinador/*
	handle @interno {
		respond 404
	}
	@cuentas path /oauth/* /cuentas/*
	handle @cuentas {
		reverse_proxy {$WEB_CUENTAS_DESTINO:cuentas:48195}
	}
	handle {
		header Cache-Control "public, max-age=300"
		root * /auth
		try_files {path} {path}.html {path}/index.html
		file_server
	}
}

# ─────────────────────────────────────────────────────────────────────────────────────────────
#  ★ 19-nov: coordinador.eñeños.link — el PANEL del Coordinador (servidor/coordinador.py,
#    documentacion/PANEL_COORDINADOR.md). Todo va a Cuenta Eñeños con el prefijo /coordinador:
#    `/` -> /coordinador/ (la página), `/entrar?ticket=…` -> /coordinador/entrar, `/api/…` -> /coordinador/api/….
#    El ingreso con Discord/Google vuelve por auth (la vuelta ya registrada) y de ahí, con un ticket, acá.
#    ⛔ Lo interno de Cuenta Eñeños no se alcanza desde acá: todo lo que entra queda DENTRO de /coordinador.
#    Sin WEB_COORDINADOR_NOMBRE queda en `http://coordinador.localhost` (local).
# ─────────────────────────────────────────────────────────────────────────────────────────────
{$WEB_COORDINADOR_NOMBRE:http://coordinador.localhost} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	rewrite * /coordinador{path}
	reverse_proxy {$WEB_CUENTAS_DESTINO:cuentas:48195}
}
