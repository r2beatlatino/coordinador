# ★ 18-nov — la CDN del sistema nuevo (cdn.eñeños.link, CON la nube de Cloudflare): el VPS le entrega los archivos
#   SÓLO a Cloudflare (como Chile: «el VPS nunca entrega a los usuarios, sólo a la CDN»). Cada versión tiene su carpeta:
#   se guarda en Cloudflare un año (regla de caché de la zona). Sólo carpetas de release, nada de _subidas/_offline.
cdn.xn--eeos-gqab.link {
	route {
		@no_cf not remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32 
		respond @no_cf "solo por Cloudflare" 403
		header Cache-Control "public, max-age=31536000, immutable"
		@r2 path_regexp ^/r2beat2013/(r2beat2013_[A-Za-z0-9._-]+|r2beat-moderno_[A-Za-z0-9._-]+|launcher)/[^.]
		handle @r2 {
			uri strip_prefix /r2beat2013
			root * /opt/enenos/releases
			file_server
		}
		# ★ 18-nov (Benja: «nuestra versión de EDA, el mismo orden»): los archivos del cliente de EDA (los de prod)
		handle_path /eda/* {
			root * /opt/eda/files-eda
			file_server
		}
		handle_path /gunbound/* {
			root * /opt/enenos/gunbound_web/cliente
			file_server
		}
		respond 404
	}
}
